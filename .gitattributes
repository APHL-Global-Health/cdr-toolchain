# Shell scripts must keep LF endings even in a Windows working copy. With
# core.autocrlf=true they would otherwise be checked out with CRLF, and a .sh
# carrying CRLF fails on Linux with `bad interpreter: /usr/bin/env bash^M` —
# which matters because these scripts get handed to deployment teams directly,
# not always via a fresh clone.
*.sh text eol=lf

# PowerShell is Windows-side; CRLF is the native convention there.
*.ps1 text eol=crlf

# Same reasoning as *.sh: scripts/diagnose-rtt.mjs carries a
# `#!/usr/bin/env node` shebang, so a CRLF copy handed to a Linux operator
# fails with `bad interpreter: /usr/bin/env node^M` the moment anyone runs it
# directly instead of via `node <file>`.
*.mjs text eol=lf

# scripts/.env.ce.example is copied to apps/cli/.env by deployment teams, and
# push-to-ce.sh parses that file. A CRLF copy used to abort the run at the
# first blank line with "line 47: : invalid variable name" (a bare CR reads as
# a non-empty key that normalises to empty). The parser tolerates CRLF now, but
# a CR also rides invisibly on every VALUE — enough to fail the
# OPENLDR_CE_TIMEZONE format check while the error prints a correct-looking
# "+02:00". Keep the template LF so a Windows clone under core.autocrlf=true
# cannot seed the problem in the first place.
*.example text eol=lf
