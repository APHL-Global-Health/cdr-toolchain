# DISA database connection string (MSSQL)
# Example formats:
#   Server=host.example.com;Database=DisalabData;User=sa;Password=***;Encrypt=false
#   mssql://user:pass@host:1433/DisalabData
DISA_CONNECTION_STRING=

# Default output format: ndjson | json | pretty
DISA_OUTPUT=ndjson

# OpenLDR v1 database connection string (used by `disa compare`)
# Same format as DISA_CONNECTION_STRING. Can point at the same SQL instance
# but a different database, or an entirely separate server.
OPENLDR_V1_CONNECTION_STRING=

# Prefix that DISA labnos get when promoted to OpenLDR v1 RequestIDs.
# `disa compare` strips this on the DISA side and re-adds it on the v1 side.
# Deployment-specific — leave empty if your deployment doesn't prefix v1 RequestIDs.
# Known values:
#   Tanzania  → TZDISA   (e.g. DISA "TDS0114466" → v1 "TZDISATDS0114466")
#   Zambia    → (empty)  (v1 RequestID equals DISA LabNo, e.g. "ZUL0010002")
#   Mozambique → set per deployment
OPENLDR_LABNO_PREFIX=

# OpenLDR v1 database names. SQL is fully-qualified as
# [OPENLDR_V1_DATABASE_DATA].[dbo].[Requests], etc., so a single CS without a
# Database= parameter can serve both DBs (e.g. when DATA and DICT live on the
# same SQL instance). DICT is not used yet — placeholder for future commands.
OPENLDR_V1_DATABASE_DATA=OpenLDRData
OPENLDR_V1_DATABASE_DICT=OpenLDRDict

# How v1 stores LIMSPointOfCareDesc in this deployment.
#   facility_ward          — facility~ward (Tanzania, default; 2 segments).
#   district_facility_ward — province district~facility~ward (Mozambique;
#                            up to 3 segments). The source column is
#                            varchar(50) so the trailing ward (and
#                            occasionally the facility) is often truncated
#                            mid-word; some rows have only 2 segments
#                            (district~facility, no ward). Sample:
#                            "Maputo Cidade Kamavota~CS Mavalane~Consulta de Cri".
# `compare`/`compare-batch`/`export`/`export-batch` accept `--poc-format` to
# override per-run. Leave unset for Tanzania-style data.
#
# Caveat under district_facility_ward: DISA stores ward as a CODE while v1
# stores the (truncated) NAME — `ward = mismatch` for labs where both sides
# are populated is expected until a dictionary-resolution layer is added.
OPENLDR_V1_POC_FORMAT=facility_ward

# OpenLDR v2 API — used by `disa export --post` to submit the built v2
# payload. URL is the base only (no trailing slash); PATH is appended.
# TOKEN is sent as `Authorization: Bearer <token>`. Leave OPENLDR_V2_TOKEN
# empty if you're using Keycloak (below) — it'll mint tokens dynamically.
OPENLDR_V2_URL=
OPENLDR_V2_TOKEN=
OPENLDR_V2_PATH=/api/v2/lab-requests

# Keycloak — when all four KEYCLOAK_* vars are set, `disa export --post`
# mints a fresh access token via the client_credentials grant on each run
# (cached in-process, refreshed ~30s before expiry). Takes precedence over
# OPENLDR_V2_TOKEN; --token flag still overrides everything.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Country key selecting config/<country>.yaml documentation classifiers
# (e.g. zambia, tanzania). Controls which DISA panels/params are treated as
# non-test "documentation" and routed to the forms feed instead of quarantined.
OPENLDR_COUNTRY=

# OpenLDR data-feed discovery — the v2 API requires an `X-DataFeed-Id`
# header to choose plugins. The CLI resolves it by calling
# /projects → /use-cases → /feeds and matching by name. Set the three
# names below, OR set OPENLDR_DATA_FEED_ID directly to skip discovery.
OPENLDR_PROJECT_NAME=
OPENLDR_USE_CASE_NAME=
OPENLDR_DATA_FEED_NAME=
OPENLDR_DATA_FEED_ID=

# Data feed name for the v2 forms (non-test) feed. Resolved the same way as
# OPENLDR_DATA_FEED_NAME (project -> use-case -> feeds). Required only when a
# run produces documentation records to POST.
OPENLDR_FORMS_DATA_FEED_NAME=

# Self-signed local-dev: skip TLS cert verification on v2 + Keycloak fetches.
# NEVER set this in production. Equivalent to NODE_TLS_REJECT_UNAUTHORIZED=0
# for the duration of the CLI invocation. Accepts: 1, true, yes, on.
OPENLDR_V2_INSECURE_TLS=

# ---------------------------------------------------------------------------
# OpenLDR CE target (`export-batch --ce-url`)
#
# An ALTERNATIVE to the v2 block above, not an addition: setting OPENLDR_CE_URL
# is what selects CE as the target. The OPENLDR_V2_* / KEYCLOAK_* / data-feed
# vars are then unused.
#
# Note that OPENLDR_V1_CONNECTION_STRING is REQUIRED here, unlike on the v2
# path. `export-batch` refuses --no-check and --no-quarantine when the target is
# CE: CE's FHIR schemas are passthrough with nearly everything optional, so the
# v1 fidelity gate and the audit quarantine are the only checks standing between
# bad source data and the store.
# ---------------------------------------------------------------------------

# Base URL of the CE install. No trailing slash. Presence selects the CE target.
OPENLDR_CE_URL=

# Path of the CE workflow webhook. The default below already matches the path
# seeded by CE's built-in "Ingest" workflow, so leave this unset unless that
# workflow's webhook path has been changed.
OPENLDR_CE_HOOK_PATH=/api/workflows/hooks/ingest

# Per-install shared secret, sent as the `x-webhook-token` header. It is a
# random UUID minted when that CE install was seeded — NOT a shared constant,
# and not transferable between deployments. Read it from
# Studio -> Workflows -> Ingest -> the webhook trigger node.
OPENLDR_CE_WEBHOOK_TOKEN=

# UTC offset applied to DISA's unzoned timestamps. REQUIRED when targeting CE,
# with no default and no fallback: DISA stores local wall-clock, so assuming UTC
# would shift every clinical timestamp with no error and no warning. Tanzania is
# +03:00; Zambia and Mozambique are +02:00. Overridable per-run with --ce-tz.
OPENLDR_CE_TIMEZONE=
