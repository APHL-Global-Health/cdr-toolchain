# ---------------------------------------------------------------------------
# CDR toolchain -> OpenLDR CE  (Zambia)
#
# Copy to `.env` at the repo root and fill in. These are the CE-target settings
# ONLY; the base `apps/cli/.env.example` covers the v2 target and does not yet
# list any OPENLDR_CE_* variable, so copying that file alone leaves the CE path
# unconfigured.
# ---------------------------------------------------------------------------

# -- Source: Zambia's DISA*Lab (MSSQL) --------------------------------------
DISA_CONNECTION_STRING=Server=<host>;Database=DisalabData;User=<user>;Password=<pw>;Encrypt=false

# -- OpenLDR v1 mirror -------------------------------------------------------
# REQUIRED on the CE path. `export-batch` refuses --no-check and --no-quarantine
# when --ce-url is set: CE's FHIR validation is structural only (its zod schemas
# are passthrough with nearly everything optional), so the v1 fidelity gate and
# the audit quarantine are the only things standing between bad source data and
# the store. Without a reachable v1, the CE push cannot run.
OPENLDR_V1_CONNECTION_STRING=Server=<host>;Database=OpenLDRData;User=<user>;Password=<pw>;Encrypt=false
OPENLDR_V1_DATABASE_DATA=OpenLDRData
OPENLDR_V1_DATABASE_DICT=OpenLDRDict

# Zambia does NOT prefix v1 RequestIDs — the v1 RequestID equals the DISA LabNo
# (e.g. "ZUL0010002"). Leave this EMPTY. Tanzania's "TZDISA" here would match
# zero v1 rows and fail every lab's fidelity check as if the data were missing.
OPENLDR_LABNO_PREFIX=

# How v1 stores LIMSPointOfCareDesc. Tanzania = facility_ward (the default);
# Mozambique = district_facility_ward. ⚠ UNVERIFIED FOR ZAMBIA — confirm against
# a real v1 row before a bulk run. Wrong value = mis-parsed facility/ward.
OPENLDR_V1_POC_FORMAT=facility_ward

# -- Target: OpenLDR CE ------------------------------------------------------
# Base URL only, no trailing slash. Its presence is what selects the CE target
# instead of v2.
OPENLDR_CE_URL=https://<zambia-ce-host>

# Leave unset. The default `/api/workflows/hooks/ingest` already matches the
# webhook path seeded by CE's built-in "Ingest" workflow.
#OPENLDR_CE_HOOK_PATH=/api/workflows/hooks/ingest

# Per-install shared secret, sent as the `x-webhook-token` header. It is a
# random UUID generated when that CE install was seeded — it is NOT a shared
# constant and cannot be copied from another deployment. Read it from
# Studio -> Workflows -> Ingest -> the webhook trigger node.
OPENLDR_CE_WEBHOOK_TOKEN=

# REQUIRED, no default, no fallback. DISA stores unzoned local wall-clock, so
# assuming UTC would shift every clinical timestamp 2h earlier with no error and
# no warning. Zambia is UTC+2.
OPENLDR_CE_TIMEZONE=+02:00

# -- Country profile ---------------------------------------------------------
# Selects config/zambia.yaml, which routes the VIRAL panel to the
# hiv_vl_documentation form instead of quarantining it as a non-test record.
OPENLDR_COUNTRY=zambia

# -- Local dev only ----------------------------------------------------------
# Skips TLS verification. NEVER set this against a production CE.
#OPENLDR_V2_INSECURE_TLS=
